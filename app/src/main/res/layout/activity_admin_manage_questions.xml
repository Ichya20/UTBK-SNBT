<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <LinearLayout
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Kelola Soal"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="27sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvQuestionStatus"
            android:text="Memuat..."
            android:textColor="#1D4ED8"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Form Soal"
                    android:textColor="#0F172A"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/edtQuestionId"
                    android:hint="Question ID, contoh: pu_001"
                    android:inputType="text"
                    android:singleLine="true"
                    android:minHeight="50dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnLoadQuestion"
                    android:text="Load berdasarkan ID"
                    android:textColor="#1D4ED8"
                    android:backgroundTint="#E0ECFF"
                    android:minHeight="46dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="12dp" />

                <TextView
                    android:text="Subject"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <Spinner
                    android:id="@+id/spSubject"
                    android:layout_width="match_parent"
                    android:layout_height="50dp" />

                <EditText
                    android:id="@+id/edtQuestion"
                    android:hint="Tulis pertanyaan"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top"
                    android:padding="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <EditText
                    android:id="@+id/edtQuestionImageName"
                    android:hint="questionImageName, contoh: sample_image_pu_01_question"
                    android:inputType="text"
                    android:singleLine="true"
                    android:minHeight="50dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:text="Opsi Teks"
                    android:textColor="#0F172A"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/edtOptionA"
                    android:hint="Option A"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/edtOptionB"
                    android:hint="Option B"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/edtOptionC"
                    android:hint="Option C"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/edtOptionD"
                    android:hint="Option D"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/edtOptionE"
                    android:hint="Option E"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:text="Opsi Gambar Lokal, tanpa .png"
                    android:textColor="#0F172A"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/edtOptionAImageName"
                    android:hint="optionAImageName"
                    android:inputType="text"
                    android:singleLine="true"
                    android:minHeight="46dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/edtOptionBImageName"
                    android:hint="optionBImageName"
                    android:inputType="text"
                    android:singleLine="true"
                    android:minHeight="46dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/edtOptionCImageName"
                    android:hint="optionCImageName"
                    android:inputType="text"
                    android:singleLine="true"
                    android:minHeight="46dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/edtOptionDImageName"
                    android:hint="optionDImageName"
                    android:inputType="text"
                    android:singleLine="true"
                    android:minHeight="46dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/edtOptionEImageName"
                    android:hint="optionEImageName"
                    android:inputType="text"
                    android:singleLine="true"
                    android:minHeight="46dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:text="Jawaban Benar"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <Spinner
                    android:id="@+id/spAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp" />

                <EditText
                    android:id="@+id/edtExplanation"
                    android:hint="Pembahasan"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top"
                    android:padding="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <EditText
                    android:id="@+id/edtExplanationImageName"
                    android:hint="explanationImageName, tanpa .png"
                    android:inputType="text"
                    android:singleLine="true"
                    android:minHeight="50dp"
                    android:paddingHorizontal="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/btnSaveQuestion"
                    android:text="Simpan Soal"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#16A34A"
                    android:minHeight="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnDeleteQuestion"
                    android:text="Hapus Soal"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#DC2626"
                    android:minHeight="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnClearQuestion"
                    android:text="Kosongkan Form"
                    android:textColor="#1D4ED8"
                    android:backgroundTint="#E0ECFF"
                    android:minHeight="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnBackQuestion"
                    android:text="Kembali ke Dashboard"
                    android:textColor="#334155"
                    android:backgroundTint="#E2E8F0"
                    android:minHeight="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnRefreshQuestionList"
                    android:text="Refresh Daftar Soal"
                    android:textColor="#1D4ED8"
                    android:backgroundTint="#E0ECFF"
                    android:minHeight="48dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cornerRadius="12dp" />

                <TextView
                    android:id="@+id/tvQuestionList"
                    android:text="Daftar soal..."
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
