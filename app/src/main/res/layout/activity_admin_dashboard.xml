<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Dashboard Admin"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="27sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvAdminEmail"
            android:text="admin@email.com"
            android:textColor="#475569"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvAdminInfo"
            android:text="Status: Memeriksa akses..."
            android:textColor="#1D4ED8"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Menu Admin"
                    android:textColor="#0F172A"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnKelolaSoal"
                    android:text="Kelola Soal"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1D4ED8"
                    android:minHeight="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnKelolaMotivasi"
                    android:text="Kelola Motivasi"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2563EB"
                    android:minHeight="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnRefreshUsers"
                    android:text="Refresh Data User"
                    android:textColor="#1D4ED8"
                    android:backgroundTint="#E0ECFF"
                    android:minHeight="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnLogoutAdmin"
                    android:text="Logout Admin"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#DC2626"
                    android:minHeight="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Data User"
                    android:textColor="#0F172A"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvTotalUsers"
                    android:text="Memuat data user..."
                    android:textColor="#1D4ED8"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvUserList"
                    android:text="Mengambil data..."
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
