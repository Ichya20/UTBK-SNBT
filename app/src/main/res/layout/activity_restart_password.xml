<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#64B2FF"
    android:padding="24dp">

    <!-- Judul -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RESTART PASSWORD"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2E4A73"
        android:layout_marginBottom="50dp"/>

    <!-- Password Baru -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblPasswordBaru"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password Baru"
            android:textColor="#000000"
            android:layout_marginEnd="12dp"
            android:labelFor="@id/etPasswordBaru"/>

        <EditText
            android:id="@+id/etPasswordBaru"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:background="@android:drawable/edit_text"
            android:inputType="textPassword"
            android:autofillHints="newPassword"
            android:hint="Masukkan password baru"
            android:padding="12dp"/>
    </LinearLayout>

    <!-- Ulang Password -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lblUlangPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ulang Password"
            android:textColor="#000000"
            android:layout_marginEnd="12dp"
            android:labelFor="@id/etUlangPassword"/>

        <EditText
            android:id="@+id/etUlangPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:background="@android:drawable/edit_text"
            android:inputType="textPassword"
            android:autofillHints="newPassword"
            android:hint="Ulangi password"
            android:padding="12dp"/>
    </LinearLayout>

    <!-- Tombol Simpan -->
    <Button
        android:id="@+id/btnSimpan"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Simpan"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4C5BD4"/>

</LinearLayout>