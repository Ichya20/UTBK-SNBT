<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#64B2FF">

    <!-- JUDUL -->
    <TextView
        android:text="DAFTAR"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#2E4A73"
        android:layout_marginBottom="40dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- NAME -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Name"
            android:textColor="#2F55FF"
            android:layout_width="120dp"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/nama"
            android:hint="Masukkan nama"
            android:inputType="textPersonName"
            android:background="@android:drawable/edit_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"/>
    </LinearLayout>

    <!-- TELEPON -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Telepon"
            android:textColor="#2F55FF"
            android:layout_width="120dp"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/telepon"
            android:hint="+62"
            android:inputType="phone"
            android:background="@android:drawable/edit_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"/>
    </LinearLayout>

    <!-- TANGGAL -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Tgl/Bln/Thn"
            android:textColor="#2F55FF"
            android:layout_width="120dp"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/tanggal"
            android:hint="DD/MM/YYYY"
            android:inputType="date"
            android:background="@android:drawable/edit_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"/>
    </LinearLayout>

    <!-- EMAIL -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Email"
            android:textColor="#2F55FF"
            android:layout_width="120dp"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/emailDaftar"
            android:hint="Masukkan email"
            android:inputType="textEmailAddress"
            android:background="@android:drawable/edit_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"/>
    </LinearLayout>

    <!-- PASSWORD -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Password"
            android:textColor="#2F55FF"
            android:layout_width="120dp"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/passwordDaftar"
            android:hint="Masukkan password"
            android:inputType="textPassword"
            android:background="@android:drawable/edit_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"/>
    </LinearLayout>

    <!-- KONFIRMASI PASSWORD -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginBottom="25dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Konfirmasi"
            android:textColor="#2F55FF"
            android:layout_width="120dp"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/konfirmasiPassword"
            android:hint="Ulangi password"
            android:inputType="textPassword"
            android:background="@android:drawable/edit_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"/>
    </LinearLayout>

    <!-- TOMBOL DAFTAR -->
    <Button
        android:id="@+id/btnDaftarAkun"
        android:text="Daftar"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4A5BE5"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"/>

    <!-- GOOGLE -->
    <Button
        android:id="@+id/btnGoogle"
        android:text="Sign up with Google"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

</LinearLayout>