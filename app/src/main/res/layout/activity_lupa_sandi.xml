<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#64B2FF"
    android:padding="20dp"
    tools:context=".LupaSandiActivity">

    <TextView
        android:id="@+id/txtJudul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lupa Kata Sandi"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#2F4F6F"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"/>

    <TextView
        android:id="@+id/txtInstruksi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Masukkan No WA atau Email yang terdaftar"
        android:layout_below="@id/txtJudul"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:textColor="#2F4F6F"/>

    <LinearLayout
        android:id="@+id/containerInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/txtInstruksi"
        android:layout_marginTop="50dp"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/txtEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WA/Email"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#2F4F6F"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/etEmailAtauWA"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="textEmailAddress"
            android:hint="Contoh: 08123xxx / email@gmail.com"
            android:padding="10dp"
            android:background="@android:drawable/edit_text"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnKirimOtp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kirim Kode OTP"
        android:layout_below="@id/containerInput"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="20dp"
        android:backgroundTint="#5A67D8"
        android:textColor="#FFFFFF"/>

</RelativeLayout>